<!doctype html>
<html lang="es">
<head>
    <%- include('../secciones/head'); %>
</head>
<body class="d-flex flex-column min-vh-100">
    <main>
        <div class="container">
            <%- include ('../secciones/menu'); %>
            <h1>Productos EJS</h1>
            <!-- Aqui va el contenido princiial -->

            <div class="row mt-5">
                <div class="col-2"></div>
                <div class="col-8">
                    <form action="/modificarProducto" method="post">
                        <div class="card">
                            <div class="card-header">
                                <h2>Modificar Producto</h2>
                            </div>
                            <div class="card-body">
                                <input  type="text" class="form-control"
                                    readonly="true" name="idProducto" id="idProducto" 
                                    value="<%= producto.idProducto %>" />
                                <br/>
                                <input type="text" class="form-control"
                                       name="nombreProducto" id="nombreProducto"
                                       value="<%= producto.nombreProducto %>"
                                       placeholder="Nombre del Producto"/>
                                <br/>
                                <input type="text" class="form-control"
                                       name="marcaProducto" id="marcaProducto"
                                       value="<%= producto.marcaProducto%>"
                                       placeholder="Marca del Producto"/>
                                <br/>
                                <input type="number" step="0.01" class="form-control"
                                       name="precioProducto" id="precioProducto"
                                       value="<%= producto.precioProducto %>"
                                       placeholder="Precio del Producto"/>
                            </div>
                            <div class="card-footer">
                                <a class="btn btn-secondary"
                                   href="/listarProductos">Cancelar</a>
                                <button type="submit" class="btn btn-primary">
                                    Guardar cambios
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
    <footer class="footer mt-auto py-3 bg-light">
        <%- include ('../secciones/footer'); %>
    </footer>
</body>
</html>
